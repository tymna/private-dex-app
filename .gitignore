# ===== OS / editor =====
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ===== Secrets / env =====
.env
.env.*
!.env.example

# ===== Node (root-level; packages have their own .gitignore too) =====
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Aztec / Noir contract build outputs (regenerated by `aztec compile`) =====
target/
artifacts/
**/target/
**/artifacts/

# ===== Frontend generated code =====
# typed contract bindings produced by `aztec codegen`
frontend/src/artifacts/
# ephemeral deployed-address config written on each sandbox deploy
frontend/src/addresses.local.json
frontend/dist/
